{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dongran Work",
  "version": "0.1.0",
  "identifier": "com.dongran.work",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "devUrl": "http://127.0.0.1:3210",
    "frontendDist": "../../backend/target/classes/static"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Dongran Work",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["backend/target/dongran-backend-0.1.0-SNAPSHOT.jar"]
  },
  "plugins": { "shell": { "open": true } }
}
